{
  "name": "l8grid",
  "version": "0.3.0",
  "description": "Drag-and-drop, resizable, keyboard-accessible grid layout for React",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leon-Achteresch/l8grid.git"
  },
  "keywords": [
    "react",
    "grid",
    "layout",
    "dashboard",
    "drag-and-drop",
    "resizable",
    "accessible"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite playground",
    "build": "tsdown && node scripts/write-styles.mjs",
    "test": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src playground e2e",
    "size": "node scripts/check-size.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test -- --run && npm run test:compat && npm run test:fuzz && npm run build && npm run size",
    "test:compat": "vitest --run --config vitest.slow.config.ts src/compat.test.tsx",
    "build:demo": "vite build playground --base ./ --outDir ../site --emptyOutDir",
    "test:fuzz": "vitest --run --config vitest.slow.config.ts src/fuzz.test.tsx"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "l8grid-v021": "npm:l8grid@^0.2.1",
    "oxlint": "^1.90.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
